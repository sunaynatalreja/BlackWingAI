# Copy to .env locally. Populate the IIT settings using the institute-issued values.
BLACKWING_INFERENCE_PROVIDER=local
BLACKWING_OLLAMA_MODEL=qwen3:8b
BLACKWING_OLLAMA_URL=http://127.0.0.1:11434
BLACKWING_API_BASE_URL=
BLACKWING_MODEL=
BLACKWING_API_KEY=
BLACKWING_ALLOW_REMOTE=NO
BLACKWING_TEAM_KEY_COORDINATED=NO
# Use json_object only if the institute endpoint does not support json_schema.
BLACKWING_IIT_RESPONSE_FORMAT=json_schema
BLACKWING_IIT_QUOTA_HEADER=
BLACKWING_USE_RESPONSE_CACHE=YES
# Optional path to the institute CA bundle stored outside the repository.
# SSL_CERT_FILE=
